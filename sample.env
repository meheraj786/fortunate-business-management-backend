# ========================================
# FORTUNATE BUSINESS MANAGEMENT - BACKEND
# Sample Environment Configuration
# ========================================
# Copy this file to .env and configure for your environment

# ----------------
# Database
# ----------------
# MongoDB connection string
# For local development: mongodb://localhost:27017/database_name
# For production: Use your MongoDB Atlas or server connection string
MONGODB_URI=mongodb://localhost:27017/fortunate_business_db

# ----------------
# Security
# ----------------
# Secret key for JWT token generation (MUST be at least 32 characters)
# Generate a secure random string for production using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# ----------------
# Server Configuration
# ----------------
# Port the server will run on
PORT=3000

# Environment mode (development, production)
NODE_ENV=development

# Timezone for business logic (e.g., 'Asia/Dhaka', 'UTC', 'America/New_York')
# This is critical for ensuring daily operations are calculated correctly.
TZ=Asia/Dhaka

# ----------------
# CORS Configuration
# ----------------
# Frontend URL for CORS (leave empty for development, localhost is auto-allowed)
# For production: Set to your frontend domain (e.g., https://yourdomain.com)
CORS_ORIGIN=

# ----------------
# File Upload Configuration
# ----------------
# Base directory for uploads (optional, defaults to ./uploads)
# For production on Linux: /var/www/fortunate-business/uploads
# UPLOADS_DIR=/path/to/uploads

# ----------------
# Super Admin Seed
# ----------------
# Password for initial super admin account (used by seed script)
SUPER_ADMIN_PASSWORD=admin123

# ----------------
# Backup Encryption
# ----------------
# Password used to encrypt backup files (only needed if encryption is enabled in settings)
# Generate a secure password: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_PASSWORD=your-backup-encryption-password
